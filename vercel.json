{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/student", "destination": "/student.html" },
    { "source": "/faculty", "destination": "/faculty.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/tasks", "destination": "/assignments.html" },
    { "source": "/assignments", "destination": "/assignments.html" },
    { "source": "/announcements", "destination": "/announcements.html" },
    { "source": "/feed", "destination": "/announcements.html" },
    { "source": "/assistant", "destination": "/assistant.html" },
    { "source": "/ai", "destination": "/assistant.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
